{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeAlign",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": "arn:aws:lambda:us-east-1:REPLACE_ACCOUNT_ID:function:petadex-diamond-align"
    },
    {
      "Sid": "AlignmentStatus",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::petadex/alignments/*"
    }
  ]
}
